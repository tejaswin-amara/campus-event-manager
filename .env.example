# Local development only. Copy to .env and replace every placeholder.
MYSQLDATABASE=campus_events
MYSQLUSER=campus_app
MYSQLPASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_LOCAL_PORT=3306
APP_BIND_ADDRESS=127.0.0.1
PORT=9090
ADMIN_PASSWORD=replace-with-a-local-admin-password
SPRING_PROFILES_ACTIVE=default
MYSQL_USE_SSL=false
COOKIE_SECURE=false
LOG_LEVEL=INFO
HEALTH_SHOW_DETAILS=never
